{
  "manifest_version": 2,
  "name": "Apps Script Touch full page zoom",
  "version": "1.1.0",
  "description": "Scales the whole Google Apps Script UI uniformly. No project content is accessed.",
  "browser_specific_settings": {
    "gecko": {
      "id": "codezoom@appscripttouch.local"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "https://script.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://script.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}